<Window x:Class="YaziDesktopHost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yazi Terminal"
        Background="{DynamicResource HostBackgroundBrush}"
        Foreground="{DynamicResource HostForegroundBrush}"
        MinWidth="640"
        MinHeight="360"
        Width="1280"
        Height="800"
        Loaded="Window_Loaded"
        ContentRendered="Window_ContentRendered"
        Activated="Window_Activated"
        LocationChanged="Window_LocationChanged"
        SizeChanged="Window_SizeChanged"
        StateChanged="Window_StateChanged"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">
    <Grid Background="{DynamicResource HostBackgroundBrush}">
        <Grid x:Name="TerminalHost"
              Background="{DynamicResource TerminalBackgroundBrush}" />
    </Grid>
</Window>
