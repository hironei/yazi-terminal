<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\eng\ThirdPartyRedistribution.props" />

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <ApplicationIcon>..\..\assets\icons\yazi-terminal-icon.ico</ApplicationIcon>
    <AssemblyName>YaziTerminal</AssemblyName>
    <Product>Yazi Terminal</Product>
    <Description>Windows WPF host for the Yazi terminal file manager.</Description>
    <Version>1.0.6</Version>
    <AssemblyVersion>1.0.6</AssemblyVersion>
    <FileVersion>1.0.6</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EasyWindowsTerminalControl" Version="1.0.38" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\third-party\**\*.*" Link="third-party\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="RequireThirdPartyRedistributionEvidence" BeforeTargets="PrepareForPublish">
    <Error Condition="'$(ThirdPartyRedistributionState)' != 'verified'"
           Text="Binary publish is blocked until third-party redistribution evidence is verified. See eng/third-party/redistribution-manifest.json and Issue #21." />
  </Target>

</Project>
