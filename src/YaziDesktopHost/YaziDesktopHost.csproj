<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <ApplicationIcon>..\..\assets\icons\yazi-terminal-icon.ico</ApplicationIcon>
    <AssemblyName>YaziTerminal</AssemblyName>
    <Product>Yazi Terminal</Product>
    <Description>Windows WPF host for the Yazi terminal file manager.</Description>
    <Version>0.1.5</Version>
    <AssemblyVersion>0.1.5</AssemblyVersion>
    <FileVersion>0.1.5</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EasyWindowsTerminalControl" Version="1.0.38" />
  </ItemGroup>

</Project>
